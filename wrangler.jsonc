{
  "name": "deepinfer-explain",
  "compatibility_date": "2026-09-24",
  "main": "./src/video-worker.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "inf.latent.space", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/blender/*.mp4"],
    "not_found_handling": "single-page-application"
  }
}
